#include <stdio.h>

int main(void) {
    int arr[5];
    int max, min;

    for (int i = 0; i < 5; i++) {
        printf("%d번째 정수 입력: ", i + 1);
        scanf("%d", &arr[i]);
    }

    max = min = arr[0];
    for (int i = 1; i < 5; i++) {
        if (arr[i] > max) max = arr[i];
        if (arr[i] < min) min = arr[i];
    }

    printf("최댓값: %d\n", max);
    printf("최솟값: %d\n", min);
    return 0;
}
