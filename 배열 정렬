#include <stdio.h>

int main(void) {
    int arr[5];
    int temp;

    for (int i = 0; i < 5; i++) {
        printf("%d번째 정수 입력: ", i + 1);
        scanf("%d", &arr[i]);
    }

    for (int i = 0; i < 4; i++) {
        for (int j = 0; j < 4 - i; j++) {
            if (arr[j] > arr[j + 1]) {
                temp = arr[j];
                arr[j] = arr[j + 1];
                arr[j + 1] = temp;
            }
        }
    }

    printf("오름차순 정렬 결과: ");
    for (int i = 0; i < 5; i++) {
        printf("%d ", arr[i]);
    }
    printf("\n");

    return 0;
}
