#include <stdio.h>

int main(void) {
    int scores[5];
    int sum = 0;
    int max;

    for (int i = 0; i < 5; i++) {
        printf("%d번째 점수 입력: ", i + 1);
        scanf("%d", &scores[i]);
        sum += scores[i];
    }

    max = scores[0];
    for (int i = 1; i < 5; i++) {
        if (scores[i] > max) max = scores[i];
    }

    printf("합계: %d\n", sum);
    printf("평균: %.2f\n", sum / 5.0);
    printf("최고점: %d\n", max);
    return 0;
}
